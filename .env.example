APP_URL=http://localhost:3000
PORT=3000
# Docker's loopback host port; choose an unused port on a shared host.
HOST_PORT=3000
DATABASE_PATH=./data/some-company.sqlite
# Set both for real email delivery. Verify EMAIL_FROM domain with Resend.
RESEND_API_KEY=
EMAIL_FROM=Some Company <hello@example.com>
# Comma-separated exact email addresses allowed into /#admin after login.
ADMIN_EMAILS=
# Set to 1 ONLY behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Local-only development: writes links to server console; prohibited in production.
DEV_EMAIL_CONSOLE=0
